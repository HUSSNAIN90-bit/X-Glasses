OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-astra
# Optional: use only if your account supports OpenAI's higher-cost fast tier.
OPENAI_VISION_SERVICE_TIER=

# Groq is used for normal text chat, intent parsing, and lightweight text responses.
LLM_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

ENVIRONMENT=development

# Gemini Live uses a short-lived token; keep this key on the backend only.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
